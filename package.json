{
  "name": "mrcha-crm",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "trap 'kill 0' EXIT; bun run dev:api & bun run dev:client",
    "dev:api": "bun run src/local-dev.ts",
    "dev:client": "vite --config client/vite.config.ts --host 127.0.0.1",
    "dev:ladle": "ladle serve --host 127.0.0.1",
    "build": "vite build --config client/vite.config.ts",
    "build:ladle": "ladle build",
    "deploy:worker": "bun run build && wrangler deploy",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --max-warnings 0",
    "format": "prettier . --write",
    "format:check": "prettier --check package.json tsconfig.json \"*.config.{js,ts}\" \".ladle/config.mjs\" \"test/**/*.ts\" \"client/src/**/*.test.tsx\" \"client/src/**/*.stories.tsx\"",
    "test:unit": "vitest run",
    "test:unit:watch": "vitest",
    "test:server": "EMBED_ON_WRITE=off PUSH_NOTIFY=off AI_HINT_ON_WRITE=off bun test --env-file=.env.local",
    "test:pure": "bun run src/scripts/run-pure-tests.ts",
    "test:edge": "deno test supabase/functions",
    "check:residue": "bun run --env-file=.env.local src/scripts/check-test-residue.ts",
    "check:lenders": "bun run --env-file=.env.local src/scripts/check-lender-parity.ts",
    "purge:assistant": "bun run --env-file=.env.local src/scripts/purge-assistant-messages.ts",
    "knip": "knip --no-config-hints",
    "test": "bun run test:server && bun run test:unit && bun run test:edge",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:pull:catalog": "drizzle-kit pull --config=drizzle.config.catalog.ts",
    "seed:customers": "bun run --env-file=.env.local scripts/seed-customers.ts"
  },
  "dependencies": {
    "@base-ui/react": "^1.6.0",
    "@fontsource-variable/geist": "^5.3.0",
    "@hono/zod-validator": "^0.9.0",
    "@supabase/supabase-js": "^2.111.0",
    "@tailwindcss/vite": "^4.3.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "drizzle-orm": "^0.45.2",
    "hono": "^4.12.32",
    "jose": "^6.2.8",
    "lucide-react": "^1.27.0",
    "pdf-lib": "^1.17.1",
    "postgres": "^3.4.9",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-markdown": "^10.1.0",
    "react-router": "^8.3.0",
    "remark-gfm": "^4.0.1",
    "tailwind-merge": "^3.6.0",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.4.0",
    "vite": "^8.1.5",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@ladle/react": "^5.1.1",
    "@playwright/test": "^1.62.1",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^7.0.0",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.3",
    "@types/bun": "^1.3.14",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^6.0.5",
    "drizzle-kit": "^0.31.10",
    "eslint": "^10.8.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.3",
    "globals": "^17.8.0",
    "jsdom": "^30.0.1",
    "knip": "^6.29.0",
    "prettier": "^3.9.6",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.65.0",
    "vitest": "^4.1.10",
    "wrangler": "^4.115.0"
  }
}
